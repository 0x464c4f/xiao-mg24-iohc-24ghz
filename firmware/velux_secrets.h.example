/***************************************************************************//**
 * @file velux_secrets.h.example
 * @brief Optional compile-time configuration template for velux_secrets.h
 *
 * NOTE: You do NOT need to create velux_secrets.h to use this firmware!
 * You can configure the 1-Way transfer key and pair your remotes entirely at
 * runtime over USB serial (persisted to internal Flash NVM at 0x0817C000):
 *
 *   velux set_transfer_key <32-hex-chars>
 *   velux pair blind
 *   velux pair skylight
 *
 * If you prefer to bake defaults in at compile time, copy this file to
 * `velux_secrets.h` (which is git-ignored) and fill in your values.
 ******************************************************************************/
#ifndef VELUX_SECRETS_H
#define VELUX_SECRETS_H

// Set to 1 if you populate the transfer key below
#define VELUX_HAS_COMPILE_TIME_TRANSFER_KEY 0

// 16-byte io-homecontrol 1-Way system key-transfer obfuscation key
// (See rspaargaren/iohomecontrol documentation)
#define VELUX_COMPILE_TIME_TRANSFER_KEY { \
  0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, \
  0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00  \
}

#endif // VELUX_SECRETS_H
